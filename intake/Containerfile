FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /opt/app
COPY intake/requirements.txt ./intake/requirements.txt
RUN pip install --no-cache-dir -r intake/requirements.txt
COPY models ./models
COPY intake ./intake
RUN chgrp -R 0 /opt/app && chmod -R g=u /opt/app

EXPOSE 8080
USER 1001
CMD ["uvicorn", "intake.http_intake:app", "--host", "0.0.0.0", "--port", "8080"]
