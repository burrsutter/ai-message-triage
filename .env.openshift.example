# =============================================================================
# ai-message-triage — environment template for running ON OPENSHIFT
# =============================================================================
# Copy to .env (or load into a ConfigMap + Secret) and fill in the <...> values.
#
# All LLM-backed agents use the shared MaaS settings below by default. Optional
# per-agent variables can override any of the three shared values when needed.
# See MODEL-CONFIG.md for the fallback behavior and per-agent matrix.
# =============================================================================

# ----- Shared model configuration -------------------------------------------
# Store API_KEY in an OpenShift Secret; do not commit the real value here.
API_KEY=<MAAS_API_KEY>
INFERENCE_SERVER_URL=https://maas-rhdp.apps.maas.redhatworkshops.io/v1
MODEL_NAME=qwen3-235b

# ----- Kafka (in-cluster AMQ Streams — see OPENSHIFT.md) ----------------------
# In-cluster PLAINTEXT bootstrap. If the agents run in the 'message-triage' namespace you
# can shorten this to message-triage-kafka-kafka-bootstrap:9092
KAFKA_BROKER=message-triage-kafka-kafka-bootstrap.message-triage.svc:9092

# Topic names are identical to the local setup — do not change.
KAFKA_INPUT_TOPIC=input
KAFKA_OUTPUT_TOPIC=output
KAFKA_REVIEW_TOPIC=review
KAFKA_INTAKE_TOPIC=intake
KAFKA_OUTFLOW_TOPIC=outflow

KAFKA_STRUCTURE_INPUT_TOPIC=intake
KAFKA_STRUCTURE_OUTPUT_TOPIC=structured

KAFKA_GUARDIAN_INPUT_TOPIC=structured
KAFKA_GUARDIAN_OUTPUT_TOPIC=cleared
# qwen3-235b is a general model, so use explicit structured safety prompts.
GUARDIAN_MODE=prompted

KAFKA_CUSTOMER_INPUT_TOPIC=cleared
KAFKA_CUSTOMER_OUTPUT_TOPIC=ready

KAFKA_ROUTER_INPUT_TOPIC=ready
KAFKA_ROUTER_OUTPUT_SUPPORT_TOPIC=support
KAFKA_ROUTER_OUTPUT_FINANCE_TOPIC=finance
KAFKA_ROUTER_OUTPUT_WEBSITE_TOPIC=website

KAFKA_SUPPORT_INPUT_TOPIC=support
KAFKA_FINANCE_INPUT_TOPIC=finance
KAFKA_WEBSITE_INPUT_TOPIC=website

KAFKA_OPPORTUNITY_INPUT_TOPIC=review
KAFKA_OPPORTUNITY_OUTPUT_TOPIC=sales

# One independent consumer group per event-driven agent.
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_STRUCTURE_GROUP_ID=message-triage-structure
KAFKA_GUARDIAN_GROUP_ID=message-triage-guardian
KAFKA_CUSTOMER_GROUP_ID=message-triage-customer
KAFKA_ROUTER_GROUP_ID=message-triage-router
KAFKA_SUPPORT_GROUP_ID=message-triage-support
KAFKA_FINANCE_GROUP_ID=message-triage-finance
KAFKA_WEBSITE_GROUP_ID=message-triage-website
KAFKA_OPPORTUNITY_GROUP_ID=message-triage-review-to-sales

# ----- Optional per-agent model overrides -----------------------------------
# Leave these unset to use the shared MaaS configuration above. If an agent
# later needs a specialized model, set any or all of its prefixed variables:
#
# GUARDIAN_API_KEY=
# GUARDIAN_SERVER_URL=
# GUARDIAN_MODEL_NAME=
#
# OPPORTUNITY_API_KEY=
# OPPORTUNITY_SERVER_URL=
# OPPORTUNITY_MODEL_NAME=
#
# The same override pattern is supported for STRUCTURE, ROUTER, SUPPORT,
# WEBSITE, and FINANCE.

# ----- Local tool APIs (FastAPI sidecars / Services) --------------------------
# In-cluster these should be Kubernetes Services, not 127.0.0.1.
# website -> password-reset tool
WEBSITE_API_HOST=<website-api.svc-or-127.0.0.1>
WEBSITE_API_PORT=8001
# finance -> order/invoice/dispute/receipt tools
FINANCE_API_HOST=<finance-api.svc-or-127.0.0.1>
FINANCE_API_PORT=8002

# ----- Databases (customer lookup + support RAG) -----------------------------
# The self-contained OpenShift demo disables these integrations. Set them back
# to the database-backed modes after deploying Northwind and pgvector.
CUSTOMER_LOOKUP_MODE=passthrough
SUPPORT_RAG_ENABLED=false
OPPORTUNITY_CODE_EXECUTION_ENABLED=false
OPPORTUNITY_MODE=route-to-sales

# Point at an in-cluster/managed Postgres (with pgvector for the KBASE_* one).
CUSTOMER_DBNAME=northwind
CUSTOMER_DBUSER=postgres
CUSTOMER_DBPASSWORD=<DB_PASSWORD>
CUSTOMER_DBHOST=<postgres.svc>
CUSTOMER_DBPORT=5432

KBASE_DBNAME=pgvector_rag
KBASE_DBUSER=postgres
KBASE_DBPASSWORD=<DB_PASSWORD>
KBASE_DBHOST=<pgvector.svc>
KBASE_DBPORT=5432
KBASE_RAG_TABLE=techkbase

# ----- File intake -----------------------------------------------------------
# The HTTP intake Deployment mounts an ephemeral emptyDir here. Received files
# are moved to /data/intake/done/*.done and disappear when its pod is replaced.
WATCH_DIRECTORY=/data/intake
HTTP_INTAKE_MAX_BYTES=1048576
INGESTION_DIRECTORY=./ingestion
